# Copy to .env.local for local dev, or set these on the server.
# .env.local is gitignored — never commit real values.

# ---- Typeform ----------------------------------------------------------------
# Personal Access Token: Typeform → Settings → Personal tokens.
# Without it the site falls back to data/submissions.json.
TYPEFORM_TOKEN=

# Only if you point the site at a different form.
# TYPEFORM_FORM_ID=MbmNRCNH

# Tag a response with any of these in the Typeform inbox and it drops off the
# public page. Comma-separated, case-insensitive. Defaults to "hide".
# TYPEFORM_HIDDEN_TAGS=hide,spam

# ---- Admin (/admin) ----------------------------------------------------------
# REQUIRED to turn /admin on. While unset, the page stays disabled rather than
# open. Use a long random string.
ADMIN_PASSWORD=

# Optional. Signs the admin session cookie; derived from ADMIN_PASSWORD if unset,
# which means changing the password logs everyone out. Set it explicitly to keep
# sessions alive across a password change.
# ADMIN_SESSION_SECRET=

# Where admin edits are written. Defaults to ./data/overrides.json — point this
# at your persistent volume if the working directory isn't persistent, or every
# edit will vanish on the next deploy.
# OVERRIDES_PATH=/data/overrides.json

# ---- Kit / ConvertKit (/live workshop signup) ---------------------------------
# The signup form on /live posts to /api/subscribe, which forwards to Kit
# server-side. With none of these set the form answers "Signups aren't open yet"
# and the page still renders.
#
# v4 (preferred). Key: Kit -> Settings -> Advanced -> API -> API Key.
# Form ID: the number in the form editor URL, app.kit.com/forms/designers/<id>/edit
KIT_API_KEY=
KIT_FORM_ID=

# Kit custom field the submitted channel link is written to. Create the field in
# Kit first (Grow -> Subscribers -> custom fields) or the link is dropped
# silently. Defaults to "channel_url".
# KIT_CHANNEL_FIELD=channel_url

# Legacy v3 fallback, used only if the pair above is unset.
# CONVERTKIT_API_KEY=
# CONVERTKIT_FORM_ID=
